JAVA_HOME=/opt/java/jdk21
DB_URL=jdbc:mysql://localhost:3306/vueadmin?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=root
# Production must use a dedicated application DB user and a non-empty password.
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRE_SECONDS=86400
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Production requires a non-empty Redis password.
REDIS_DATABASE=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
BOOTSTRAP_ADMIN=false

# Default local profile imports .env.local; prod accepts explicit environment/config only.
# Containers default to prod. Set every required value above to a non-empty value.
# SERVER_PORT=8081
# SPRING_PROFILES_ACTIVE=prod
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75

# Server-only community operations bridge. An empty key disables it.
COMMUNITY_API_URL=http://localhost:8080
COMMUNITY_ADMIN_KEY=
